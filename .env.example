# Copy to .env.local for local development. Real values live in Vercel's
# project settings, never in the repository.
#
# Every variable here is optional: the site builds and runs correctly with all
# of them unset. Analytics is skipped and the contributions table falls back to
# the curated list in src/data/contributions.ts.

# ── GitHub ────────────────────────────────────────────────────────────────
# Server-side only. Refreshes the open-source table hourly and discovers new
# upstream PRs. A fine-grained token with *public repo read* is enough — this
# only ever calls the public search API.
# Without it: the curated list renders exactly as authored.
GITHUB_TOKEN=

# ── PostHog ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ because it ships to the browser; the project key is designed to
# be public and is safe in client code. Ingestion is restricted by PostHog's
# allowed-origins setting, not by hiding this value.
# Without it: nothing loads and no request is made.
#
# NOTE: there is deliberately no host variable. Events are sent same-origin to
# /ingest and proxied by the rewrite in next.config.ts, so ad blockers don't
# drop them. Setting a host here would bypass that. If this project is ever
# moved to PostHog EU, change the rewrite destinations instead.
NEXT_PUBLIC_POSTHOG_KEY=
